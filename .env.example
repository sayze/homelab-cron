# Copy to .env and fill in for `docker compose up`.

# Optional: host port to publish the api service's /health + GET
# /job/{name} on (container always listens on 8080).
ADDR_HOST_PORT=8080

# Optional: path (inside the container) where the host filesystem is
# mounted, read-only. In production this is a raw Docker bind mount (see
# homelab-cron.nomad.hcl: "/:/host:ro,rslave"); here it's bind-mounted from
# HOST_ROOT_HOST_PATH below (defaults to your actual "/", read-only, to
# mirror production — override to a narrower path if you'd rather not
# expose your whole machine to the dev container).
HOST_ROOT=/host
HOST_ROOT_HOST_PATH=/

# Optional: job alert emails (see internal/mailer). Both must be set for
# alerting to be enabled — leave unset to have alerting jobs just log
# instead of sending, which is fine for local dev. ALERT_EMAIL_TO accepts
# a comma-separated list of recipients.
# ALERT_EMAIL_FROM=cron@yourdomain.com
# ALERT_EMAIL_TO=you@yourdomain.com

# Required if ALERT_EMAIL_FROM/ALERT_EMAIL_TO are set: AWS SES credentials.
# Read directly by the AWS SDK's own default env chain, not by this
# service's config — see internal/mailer/ses.go.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-southeast-2

# Optional: Consul's HTTP API base URL, used by internal/consul.HTTPClient
# to read Traefik/PostgreSQL/New Relic Infrastructure's deployed version
# from Consul service meta (see internal/jobs/webstackversioncheck.go).
# Defaults to Consul's default local-agent address, which won't be
# reachable from inside the container unless Consul is exposed to it (e.g.
# `docker compose`'s default bridge network can't reach 127.0.0.1 on the
# host) — override to a Consul address reachable from this container.
CONSUL_ADDR=http://127.0.0.1:8500

# Optional: Vault's HTTP API base URL, used by internal/vault.HTTPClient to
# read Vault's own deployed version from its unauthenticated health
# endpoint (see internal/jobs/webstackversioncheck.go). Defaults to
# Vault's default local-agent address, same reachability caveat as
# CONSUL_ADDR above.
VAULT_ADDR=http://127.0.0.1:8200

# Optional: Nomad's HTTP API base URL, used by internal/nomad.HTTPClient to
# read Nomad's own deployed version from its agent-self endpoint (see
# internal/jobs/webstackversioncheck.go). Defaults to Nomad's default
# local-agent address, same reachability caveat as CONSUL_ADDR above.
NOMAD_ADDR=http://127.0.0.1:4646

# Required for the Nomad version check to authenticate, if Nomad's ACLs are
# enabled: an ACL token with at least agent:read, sent as Nomad's
# X-Nomad-Token header. In production this is rendered from Vault (see
# homelab-cron.nomad.hcl's template block); unset here just means that one
# check fails locally, which is reported rather than fatal.
# NOMAD_TOKEN=

# Optional: path (inside the container) to the Docker Engine API's Unix
# socket, used by internal/docker.HTTPClient to read the local daemon's own
# deployed version (see internal/jobs/webstackversioncheck.go). Defaults to
# Docker's standard socket path. Bind-mounted from DOCKER_SOCK_HOST_PATH
# below (defaults to the same path on your host) — this grants the
# container the full Docker Engine API of whatever host it's mounted from,
# which is root-equivalent access; comment out the mount in
# docker-compose.yml if you'd rather not expose it locally.
DOCKER_SOCK=/var/run/docker.sock
DOCKER_SOCK_HOST_PATH=/var/run/docker.sock
